authors: "Gang Chen"
license: "MIT"
depends: [
  "ocaml" {= "4.14.1"}
  "rocq-core" {= "9.2.0"}
  "rocq-stdlib" {= "9.2.0"}
  "coq-coquelicot" {= "3.4.5"}
]
build: [[make "check-rocq"]]
